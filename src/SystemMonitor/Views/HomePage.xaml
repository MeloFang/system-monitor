<UserControl x:Class="SystemMonitor.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SystemMonitor.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,6,0,20">
            <TextBlock Style="{StaticResource H2}">控制<Run Foreground="{StaticResource Rog}">首页</Run></TextBlock>
            <TextBlock Style="{StaticResource Sub}">选择一个入口开始 — 硬件监控与模型引擎统一管理</TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Stretch">
            <!-- 硬件监控卡（原型 .card.monitor） -->
            <Border x:Name="CardMon" Style="{StaticResource HomeCardMon}" Margin="0,0,0,18"
                    MouseLeftButtonUp="MonitorCard_Click">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource RogSoft}"
                                    BorderBrush="{StaticResource Rog}" BorderThickness="1" Effect="{StaticResource GlowRog}" Margin="0,0,12,0">
                                <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource Rog}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3 12h4l2-7 4 14 2-7h6"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="硬件监控" FontSize="17" FontWeight="ExtraBold"/>
                                <TextBlock Text="MONITOR · LHM + NVML" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="MonStatusBd" HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="14" Padding="9,4" Background="{StaticResource OkSoft}" BorderBrush="#2b5c40" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="MonPd" Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="MonStatus" Text="采集中" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="GPU 温度" Style="{StaticResource KLabel}"/>
                            <TextBlock Style="{StaticResource StatNum}" Foreground="{StaticResource Rog}"><Run x:Name="HwGpuTemp" Text="--"/><Run FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Normal">°C</Run></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="显存占用" Style="{StaticResource KLabel}"/>
                            <TextBlock Style="{StaticResource StatNum}"><Run x:Name="HwVram" Text="--"/><Run FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Normal">/16 GB</Run></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="GPU 负载" Style="{StaticResource KLabel}"/>
                            <TextBlock Style="{StaticResource StatNum}"><Run x:Name="HwGpuLoad" Text="--"/><Run FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Normal">%</Run></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="CPU 温度" Style="{StaticResource KLabel}"/>
                            <TextBlock Style="{StaticResource StatNum}"><Run x:Name="HwCpuTemp" Text="--"/><Run FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Normal">°C</Run></TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                        <Grid>
                            <TextBlock Text="进入硬件监控" Foreground="{StaticResource Rog}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="→" Foreground="{StaticResource Rog}" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 模型引擎卡（原型 .card.engine） -->
            <Border x:Name="CardEng" Style="{StaticResource HomeCardEng}" Margin="0"
                    MouseLeftButtonUp="EngineCard_Click">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="EngIconBd" Width="44" Height="44" CornerRadius="12" Background="{StaticResource OllamaSoft}"
                                    BorderBrush="{StaticResource Ollama}" BorderThickness="1" Effect="{StaticResource GlowOllama}" Margin="0,0,12,0">
                                <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource Ollama}" StrokeThickness="1.8"
                                      Data="M12 3a9 9 0 1 0 9 9M12 7a5 5 0 1 0 5 5M12 11a1.5 1.5 0 1 0 1.5 1.5"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="模型引擎" FontSize="17" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="EngSub" Text="ENGINE · OLLAMA" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="EngStatusBd" HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="14" Padding="9,4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line2}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EngPd" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EngStatus" Text="已停止" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Faint}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="当前引擎·模型" Style="{StaticResource KLabel}"/>
                        <TextBlock x:Name="EngModel" Text="--" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="生成速度" Style="{StaticResource KLabel}"/>
                            <TextBlock Style="{StaticResource StatNum}"><Run x:Name="EngTok" Text="--"/><Run FontSize="11" Foreground="{StaticResource Dim}" FontWeight="Normal"> tok/s</Run></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="端点" Style="{StaticResource KLabel}"/>
                            <TextBlock x:Name="EngUrl" Text="--" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Cpu}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                        <Grid>
                            <TextBlock x:Name="EngGo" Text="进入模型引擎" Foreground="{StaticResource Ollama}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EngGoArr" Text="→" Foreground="{StaticResource Ollama}" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
