<UserControl x:Class="SystemMonitor.Views.EngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SystemMonitor.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 分段 + 切换/停止（窄窗自动换行） -->
        <StackPanel Grid.Row="0" Margin="0,6,0,20">
            <TextBlock Style="{StaticResource H2}">模型<Run Foreground="{StaticResource Rog}">引擎</Run></TextBlock>
            <TextBlock x:Name="HeadSub" Style="{StaticResource Sub}">当前在跑 · —</TextBlock>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="SegOllama" Style="{StaticResource SegBtn}" Click="SegOllama_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SegOllamaDot" Width="8" Height="8" Fill="{StaticResource Faint}" Margin="0,0,8,0"/>
                        <TextBlock Text="Ollama"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SegStrata" Style="{StaticResource SegBtn}" Click="SegStrata_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SegStrataDot" Width="8" Height="8" Fill="{StaticResource Faint}" Margin="0,0,8,0"/>
                        <TextBlock Text="Strata"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SwitchBtn" Style="{StaticResource Btn}" Content="切换引擎 ⇄" Click="SwitchBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="StopBtn" Style="{StaticResource BtnDanger}" Content="停止引擎" Click="StopBtn_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- 当前引擎摘要条（原型 .eng-sum：左 4px ollama→strata 渐变） -->
        <Border Grid.Row="1" Style="{StaticResource Card}" CornerRadius="16" Padding="20,16" Margin="0,0,0,18">
            <Grid>
                <Border Width="4" HorizontalAlignment="Left" Margin="-20,-16,0,-16" Background="{StaticResource SumAccent}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
                        <Ellipse x:Name="EsDot" Width="14" Height="14" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="EsName" Text="Ollama" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Ollama}"/>
                            <TextBlock x:Name="EsState" Text="—" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource Faint}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="EsDesc" Text="本地模型推理 · OpenAI 兼容" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="当前模型" Style="{StaticResource KLabel}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="EsModel" Text="--" FontFamily="Consolas" FontSize="17" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="生成速度" Style="{StaticResource KLabel}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="EsTok" Text="--" FontFamily="Consolas" FontSize="17" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="端点" Style="{StaticResource KLabel}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EsUrl" Text="--" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Cpu}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="EsCopy" Grid.Column="1" Style="{StaticResource CopyBtn}" Content="复制" Click="EsCopy_Click" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 竖排单列（与预览一致）：模型面板 → 指标 → 曲线 → 调用助手 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Stretch">
            <Border Style="{StaticResource Card}" CornerRadius="16" Padding="20" Margin="0,0,0,18">
                <Grid>
                    <StackPanel x:Name="OllamaPanel">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource OllamaSoft}" Margin="0,0,9,0">
                                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Ollama}" StrokeThickness="1.8"
                                      Data="M12 3a9 9 0 1 0 9 9M12 7a5 5 0 1 0 5 5"/>
                            </Border>
                            <TextBlock Text="模型管理 · Ollama" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="点选即加载 · 新增模型仍走手动 ollama pull" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,0,0,12"/>
                        <ListBox x:Name="ModelList" Style="{StaticResource DarkList}" MaxHeight="420"
                                 SelectionChanged="ModelList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="OllamaListHint" Text="" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="StrataPanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource StrataSoft}" Margin="0,0,9,0">
                                <Path Width="13" Height="13" Stretch="Uniform" Stroke="{StaticResource Strata}" StrokeThickness="1.8"
                                      Data="M4 17l6-6-6-6M12 19h8"/>
                            </Border>
                            <TextBlock Text="模型管理 · Strata" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="E:\Strata-Models 落地模型 · 选 family + quant" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,0,0,12"/>
                        <TextBlock Text="FAMILY" Style="{StaticResource KLabel}" Margin="0,0,0,6"/>
                        <ListBox x:Name="FamList" Style="{StaticResource DarkList}" MaxHeight="120"
                                 SelectionChanged="FamList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="QUANT" Style="{StaticResource KLabel}" Margin="0,10,0,6"/>
                        <ListBox x:Name="QuantList" Style="{StaticResource DarkList}" MaxHeight="140">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="StrataLoadBtn" Style="{StaticResource BtnStrata}" Content="加载所选 (launch)"
                                Click="StrataLoadBtn_Click" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

                <StackPanel>
                    <!-- 指标四格（原型 .metric：bg0 底 + 系列色 23px 值） -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="生成速度" Style="{StaticResource KLabel}"/>
                                <TextBlock x:Name="MTok" Text="--" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ollama}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,12">
                            <StackPanel>
                                <TextBlock Text="输入速度" Style="{StaticResource KLabel}"/>
                                <TextBlock x:Name="MPrompt" Text="--" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ollama}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="缓存命中" Style="{StaticResource KLabel}"/>
                                <TextBlock x:Name="MCache" Text="--" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ollama}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="上下文占用" Style="{StaticResource KLabel}"/>
                                <TextBlock x:Name="MCtx" Text="--" FontFamily="Consolas" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Ollama}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- tok/s 大曲线（原型 .bigspark：bg0 底 13 圆角） -->
                    <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="tok/s 曲线 · 最近 60s" FontSize="12" Foreground="{StaticResource Dim}"/>
                                <TextBlock x:Name="BigTokVal" Text="--" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource Ollama}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ctl:Sparkline x:Name="TokSpark" Height="110" Stroke="{StaticResource Ollama}" Min="0" Max="80"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,8,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="调用助手" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource Line}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="HelpList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,13">
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource CopyBtn}" Content="复制" Tag="{Binding Body}"
                                                Click="CopyHelp_Click" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Background="{StaticResource Bg0}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                        <TextBlock Text="{Binding Body}" FontFamily="Consolas" FontSize="12" LineHeight="20"
                                                   Foreground="{StaticResource Code}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
