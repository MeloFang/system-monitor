<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="420" Height="680" MinWidth="360" MinHeight="480"
        Topmost="True"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="{StaticResource Text}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DrawingBrush x:Key="GridLines" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Viewbox="0,0,44,44" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#07FFFFFF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0.5" EndPoint="44,0.5"/>
                            <LineGeometry StartPoint="0.5,0" EndPoint="0.5,44"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <!-- 分层氛围背景（原型 .bg：三辉光 + 44px 网格径向渐隐） -->
            <Rectangle Fill="{StaticResource Bg}"/>
            <Rectangle Width="640" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-220,0,0" Opacity="0.5">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#38FF2E4D" Offset="0"/><GradientStop Color="#00FF2E4D" Offset="0.65"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-260" Opacity="0.5">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1F2EE6C8" Offset="0"/><GradientStop Color="#002EE6C8" Offset="0.65"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="450,-260,0,0" Opacity="0.5">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A4DA3FF" Offset="0"/><GradientStop Color="#004DA3FF" Offset="0.65"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{StaticResource GridLines}">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.85"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <Grid Margin="22,0,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏（原型 .topbar：磨砂渐变 + 底边线） -->
                <Border Grid.Row="0" Background="{StaticResource TopbarBg}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1" Padding="4,14" Margin="0,0,0,22">
                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackBtn" Grid.Column="0" Style="{StaticResource BackBtn}" Content="← 首页"
                                Visibility="Collapsed" Click="Back_Click" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource LogoGrad}" Effect="{StaticResource GlowRog}">
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="#fff" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3 12h4l2-7 4 14 2-7h6"/>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="Bold">System<Run Foreground="{StaticResource Rog}">Monitor</Run></TextBlock>
                                <TextBlock Text="INFERENCE HUB" FontSize="10.5" Foreground="{StaticResource Faint}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="Crumb" Grid.Column="2" FontSize="13" Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="SensorChip" CornerRadius="14" Padding="9,4" Margin="0,0,12,0"
                                    Background="{StaticResource OkSoft}" BorderBrush="#2b5c40" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SensorPd" Width="7" Height="7" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="SensorChipText" Text="采集中" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="EngineBadge" CornerRadius="20" Padding="12,6" Margin="0,0,12,0"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Line2}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="当前引擎" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EngineBadgeText" Text="无" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ClockText" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Dim}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Style="{StaticResource Wdot}" Background="#2a3648" BorderBrush="{StaticResource Line2}" Click="Minimize_Click" Margin="0,0,7,0"/>
                            <Ellipse Width="12" Height="12" Fill="{StaticResource Overlay}" Stroke="{StaticResource Line2}" StrokeThickness="1" Margin="0,0,7,0"/>
                            <Button Style="{StaticResource Wdot}" Background="{StaticResource RogSoft}" BorderBrush="{StaticResource Rog}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 视图宿主 -->
                <ContentControl x:Name="NavHost" Grid.Row="1"/>
            </Grid>

            <!-- toast（原型 .toast） -->
            <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,24" Visibility="Collapsed" Background="{StaticResource Overlay}"
                    BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="12" Padding="18,13">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                    <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                    <Button x:Name="ToastUndo" Content="撤销" Margin="12,0,0,0" FontSize="12" FontWeight="Bold"
                            Foreground="{StaticResource Rog}" BorderBrush="#7a3a44" Background="{StaticResource RogSoft}"
                            Padding="12,5" Cursor="Hand" Visibility="Collapsed" Click="ToastUndo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
