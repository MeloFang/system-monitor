<Window x:Class="AsusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="640"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#FF0E1012"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFEDEEF0"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFE5353F"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF8A9099"/>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEEF0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEEF0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF23272C"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2.5" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFEDEEF0"/>
            <Setter Property="Background" Value="#FF1A1D21"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF262B31"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF23272C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E2226"/>
                    <Setter Property="Foreground" Value="#FFEDEEF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF1A1D21" BorderThickness="1">
        <Grid Margin="20,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,18" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="8" Height="18" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="asus-monitor" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Subtitle" Margin="14,2,0,0" Style="{StaticResource CardSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="✕" Margin="6,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 三张卡片 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Background="#FF16181B" CornerRadius="14" BorderBrush="#FF22262B" BorderThickness="1" Padding="20" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="CPU"/>
                        <TextBlock Grid.Row="1" x:Name="CpuName" Style="{StaticResource CardSubtitle}" Margin="0,3,0,14" Text="—"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="温度" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <TextBlock Text="{Binding CpuTempText}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text=" °C" FontSize="14" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="频率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="电压" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuVoltageText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="使用率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding CpuLoadValue, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="1" Background="#FF16181B" CornerRadius="14" BorderBrush="#FF22262B" BorderThickness="1" Padding="20" Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="GPU"/>
                        <TextBlock Grid.Row="1" x:Name="GpuName" Style="{StaticResource CardSubtitle}" Margin="0,3,0,14" Text="—"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="温度" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <TextBlock Text="{Binding GpuTempText}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text=" °C" FontSize="14" Foreground="{StaticResource TextDim}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="频率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuClockText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="显存频率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuMemClockText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="电压" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuVoltageText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="TGP" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="使用率" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding GpuLoadValue, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内存 -->
                <Border Grid.Column="2" Background="#FF16181B" CornerRadius="14" BorderBrush="#FF22262B" BorderThickness="1" Padding="20" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="内存"/>
                        <TextBlock Grid.Row="1" Text="{Binding MemClockText}" Style="{StaticResource CardSubtitle}" Margin="0,3,0,14"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="RAM 使用率" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                <TextBlock Text="{Binding MemLoadText}" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="已用" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding MemUsedText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="可用" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding MemAvailableText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="存储占用" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding StorageLoadText}" Style="{StaticResource MetricValue}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding StorageLoadValue, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 操作模式 -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="操作模式" Style="{StaticResource CardSubtitle}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnWindows" Style="{StaticResource ModeBtn}" Content="Windows" Tag="Windows" Click="ModeButton_Click"/>
                    <Button x:Name="BtnSilent" Style="{StaticResource ModeBtn}" Content="安静" Tag="Silent" Click="ModeButton_Click"/>
                    <Button x:Name="BtnPerformance" Style="{StaticResource ModeBtn}" Content="性能" Tag="Performance" Click="ModeButton_Click"/>
                    <Button x:Name="BtnTurbo" Style="{StaticResource ModeBtn}" Content="增强" Tag="Turbo" Click="ModeButton_Click"/>
                    <Button x:Name="BtnManual" Style="{StaticResource ModeBtn}" Content="手动" Tag="Manual" Click="ModeButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="初始化中…" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding UpdateTime, StringFormat=更新于 {0}}" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
