<Window x:Class="AsusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AsusMonitor.Converters"
        Width="720" Height="440"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#FF0C0E11"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFEDEEF0"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <conv:PercentToDashConverter x:Key="Dash"/>
        <SolidColorBrush x:Key="Accent" Color="#FFE5353F"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF7D838C"/>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEEF0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF22262B"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E2226"/>
                    <Setter Property="Foreground" Value="#FFEDEEF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF181B1F" BorderThickness="1">
        <Grid Margin="16,10,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="7" Height="17" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="asus-monitor" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="ROG Strix · 硬件监控" Margin="12,2,0,0" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="✕" Margin="6,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 三张卡片：圆环 + 指标 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="0,0,9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuName" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" Text="—"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                            <Ellipse Width="92" Height="92" Stroke="#FF22262B" StrokeThickness="6"/>
                            <Ellipse Width="92" Height="92" Stroke="{StaticResource Accent}" StrokeThickness="6"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     StrokeDashArray="{Binding CpuTempValue, Mode=OneWay, Converter={StaticResource Dash}, ConverterParameter=270}">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuTempText}" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="使用率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding CpuLoadValue, Mode=OneWay}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="频率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="电压" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuVoltageText}" Style="{StaticResource Value}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="1" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="9,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuName" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,3,0,0" Text="—"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                            <Ellipse Width="92" Height="92" Stroke="#FF22262B" StrokeThickness="6"/>
                            <Ellipse Width="92" Height="92" Stroke="{StaticResource Accent}" StrokeThickness="6"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     StrokeDashArray="{Binding GpuTempValue, Mode=OneWay, Converter={StaticResource Dash}, ConverterParameter=270}">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpuTempText}" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="使用率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding GpuLoadValue, Mode=OneWay}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="频率 / 显存" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}">
                                    <Run Text="{Binding GpuClockText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding GpuMemClockText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <TextBlock Text="TGP" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource Value}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内存 -->
                <Border Grid.Column="2" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="9,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="内存" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MemClockText}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                            <Ellipse Width="92" Height="92" Stroke="#FF22262B" StrokeThickness="6"/>
                            <Ellipse Width="92" Height="92" Stroke="{StaticResource Accent}" StrokeThickness="6"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                     StrokeDashArray="{Binding MemLoadValue, Mode=OneWay, Converter={StaticResource Dash}, ConverterParameter=270}">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MemLoadText}" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="RAM 使用率" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,7">
                                <TextBlock Text="已用 / 可用" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}">
                                    <Run Text="{Binding MemUsedText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MemAvailableText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="存储占用" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding StorageLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding StorageLoadValue, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Text="初始化中…" FontSize="11" Foreground="{StaticResource TextDim}"/>
                <TextBlock Text="{Binding UpdateTime, StringFormat=更新于 {0}}" FontSize="11"
                           Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
