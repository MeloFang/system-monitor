<Window x:Class="AsusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="460"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#FF0C0E11"
        FontFamily="Microsoft YaHei UI"
        Foreground="#FFEDEEF0"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFE5353F"/>
        <SolidColorBrush x:Key="TextDim" Color="#FF7D838C"/>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEEF0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#FF22262B"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E2226"/>
                    <Setter Property="Foreground" Value="#FFEDEEF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF181B1F" BorderThickness="1">
        <Grid Margin="16,10,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="7" Height="17" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="asus-monitor" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="ROG Strix · 硬件监控" Margin="12,2,0,0" FontSize="11" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeBtn}" Content="—" Click="Minimize_Click"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="✕" Margin="6,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- 三张卡片 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Border Grid.Column="0" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="0,0,7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="CPU" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpuName" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" LineHeight="14" Text="—"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CpuTempText}" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Viewbox Grid.Row="2" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="1.2" Fill="Transparent"
                                  Data="M6 6h12v12H6z M10 10h4v4h-4z M9 3v3 M12 3v3 M15 3v3 M9 18v3 M12 18v3 M15 18v3 M3 9h3 M3 12h3 M3 15h3 M18 9h3 M18 12h3 M18 15h3"/>
                        </Viewbox>

                        <StackPanel Grid.Row="3">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="使用率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding CpuLoadValue, Mode=OneWay}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="频率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuClockText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="电压" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CpuVoltageText}" Style="{StaticResource Value}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU -->
                <Border Grid.Column="1" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="7,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="GPU" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GpuName" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" LineHeight="14" Text="—"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GpuTempText}" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Viewbox Grid.Row="2" Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="1.2" Fill="Transparent"
                                  Data="M2 8h16v8H2z M8 12 m-2.4 0 a2.4 2.4 0 1 0 4.8 0 a2.4 2.4 0 1 0 -4.8 0 M18 10.5h3 M18 13.5h3"/>
                        </Viewbox>

                        <StackPanel Grid.Row="3">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="使用率" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding GpuLoadValue, Mode=OneWay}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="频率 / 显存" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}">
                                    <Run Text="{Binding GpuClockText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding GpuMemClockText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <TextBlock Text="TGP" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource Value}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内存 -->
                <Border Grid.Column="2" Background="#FF14171B" CornerRadius="16" BorderBrush="#FF1F2329" BorderThickness="1" Padding="16,12" Margin="7,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="内存" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,0">
                                <Run Text="{Binding MemTotalText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MemClockText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MemLoadText}" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="RAM 使用率" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>

                        <Viewbox Grid.Row="2" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Stroke="{StaticResource Accent}" StrokeThickness="1.2" Fill="Transparent"
                                  Data="M2 9h20v7H2z M5 11h3v3H5z M10.5 11h3v3h-3z M16 11h3v3h-3z M11 16v2.5h2V16"/>
                        </Viewbox>

                        <StackPanel Grid.Row="3">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="已用 / 共" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}">
                                    <Run Text="{Binding MemUsedText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MemTotalText, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="存储占用" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding StorageLoadText}" Style="{StaticResource Value}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar}" Value="{Binding StorageLoadValue, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" Text="初始化中…" FontSize="11" Foreground="{StaticResource TextDim}"/>
                <TextBlock Text="{Binding UpdateTime, StringFormat=更新于 {0}}" FontSize="11"
                           Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
